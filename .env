# 项目路径配置 (Docker环境下通常为 /root/CLPainter)
ROOT_DIR=/root
PRJ_DIR=/root/CLPainter
BKD_DIR="${PRJ_DIR}/web/backend"
APP_DIR="${PRJ_DIR}/web/backend/app"

# python环境相关
INSTALL_PATH="/root/mambaforge"
CONDA_ENV_NAME="echarts"

# 服务器配置
LHOST=0.0.0.0
PORT=8001
WORKERS=1

# 日志配置
LOG_LEVEL=DEBUG
LOG_DIR=/app/logs
LOG_FILE=/app/logs/app.log
LOG_ERROR_FILE=/app/logs/error.log
